# Copy this file to backend/.env and adjust values as needed.
# Quick local setup (recommended): keep SQLite URL below.
# MySQL example: mysql+pymysql://<user>:<password>@localhost:3306/<database_name>
DATABASE_URL=sqlite:///./drms.db
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=./uploads
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-user
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true
REFRESH_TOKEN_EXPIRE_MINUTES=43200
MFA_OTP_EXPIRE_MINUTES=10
